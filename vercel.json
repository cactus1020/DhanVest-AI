{
  "framework": "fastapi",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{venv/**,tests/**,scripts/**,**/*.db,**/*.pkl,**/*.pdf,**/*.docx,**/*.pptx,**/*.csv}"
    }
  },
  "crons": [
    {
      "path": "/api/jobs/fundamentals-sync",
      "schedule": "0 12 * * 0"
    },
    {
      "path": "/api/jobs/news-sync",
      "schedule": "0 11 * * *"
    }
  ]
}
