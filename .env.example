# Server-side only. Copy to .env locally; set in Vercel for deployment.
# Revoke the service-role key exposed in Git history before using a new key.
SUPABASE_URL=https://YOUR-ACTIVE-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-NEW-SERVER-ONLY-KEY
# Optional. Rotate the exposed Gemini key first. Omit to use factor-rule explanations.
GEMINI_API_KEY=
# Set an available model ID for your Google project; no model is assumed.
GEMINI_MODEL=
